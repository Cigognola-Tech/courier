# Docker-on-EB keeps host nginx on :80 and proxies to the container bridge IP:8080.
# HostPort publish is unreliable on this platform; the shared ALB process/TG must use port 80.
option_settings:
  aws:elasticbeanstalk:application:environment:
    COURIER_PORT: "8080"
    COURIER_SPOOL_DIR: "/tmp/courier-spool"
  aws:elasticbeanstalk:environment:process:default:
    Port: 80
    Protocol: HTTP
    HealthCheckPath: /
    MatcherHTTPCode: "200"
    HealthCheckInterval: 15
    HealthCheckTimeout: 5
    HealthyThresholdCount: 3
    UnhealthyThresholdCount: 5
